<% content_for(:finance_title) do %>
  <i class="fas fa-receipt me-1"></i> Mis Gastos
<% end %>
<% content_for(:finance_nav_actions) do %>
  <%= link_to finance_charts_path, class: "finance-nav-btn", title: "Graficos" do %>
    <i class="fas fa-chart-pie"></i>
  <% end %>
  <%= link_to finance_root_path, class: "finance-nav-btn", title: "Volver al chat" do %>
    <i class="fas fa-comment-dots"></i>
  <% end %>
<% end %>

<div class="finance-expenses-page">
  <turbo-frame id="finance_expenses_frame" target="_top">
    <div class="finance-expenses-controls">
      <%# Row 1: Period + Currency %>
      <div class="finance-filter-row">
        <div class="finance-filter-pills">
          <% %w[today week month year].each do |p| %>
            <% label = { "today" => "Hoy", "week" => "Sem", "month" => "Mes", "year" => "Anio" }[p] %>
            <%= link_to label, finance_expenses_path(period: p, currency: @currency_filter, category: @category_filter, search: @search, expense_type: @expense_type_filter),
                class: "btn-pill #{'active' if @period == p}",
                data: { turbo_frame: "finance_expenses_frame" } %>
          <% end %>
        </div>
        <span class="finance-filter-divider"></span>
        <div class="finance-filter-pills">
          <%= link_to "$", finance_expenses_path(period: @period, category: @category_filter, search: @search, expense_type: @expense_type_filter),
              class: "btn-pill #{'active' if @currency_filter.blank?}",
              title: "Todas las monedas",
              data: { turbo_frame: "finance_expenses_frame" } %>
          <%= link_to "ARS", finance_expenses_path(period: @period, currency: "ARS", category: @category_filter, search: @search, expense_type: @expense_type_filter),
              class: "btn-pill #{'active' if @currency_filter == 'ARS'}",
              data: { turbo_frame: "finance_expenses_frame" } %>
          <%= link_to "USD", finance_expenses_path(period: @period, currency: "USD", category: @category_filter, search: @search, expense_type: @expense_type_filter),
              class: "btn-pill #{'active' if @currency_filter == 'USD'}",
              data: { turbo_frame: "finance_expenses_frame" } %>
        </div>
      </div>

      <%# Row 2: Expense Type %>
      <div class="finance-filter-row">
        <div class="finance-filter-pills">
          <%= link_to "Todos", finance_expenses_path(period: @period, currency: @currency_filter, category: @category_filter, search: @search),
              class: "btn-pill #{'active' if @expense_type_filter.blank?}",
              data: { turbo_frame: "finance_expenses_frame" } %>
          <%= link_to "Fijos", finance_expenses_path(period: @period, currency: @currency_filter, category: @category_filter, search: @search, expense_type: "fijo"),
              class: "btn-pill #{'active' if @expense_type_filter == 'fijo'}",
              data: { turbo_frame: "finance_expenses_frame" } %>
          <%= link_to "Variables", finance_expenses_path(period: @period, currency: @currency_filter, category: @category_filter, search: @search, expense_type: "variable"),
              class: "btn-pill #{'active' if @expense_type_filter == 'variable'}",
              data: { turbo_frame: "finance_expenses_frame" } %>
        </div>
      </div>

      <%# Row 3: Search + Category %>
      <div class="finance-filter-row">
        <%= form_with url: finance_expenses_path, method: :get, class: "finance-filter-search", data: { turbo_frame: "finance_expenses_frame" } do %>
          <input type="hidden" name="period" value="<%= @period %>">
          <input type="hidden" name="currency" value="<%= @currency_filter %>">
          <input type="hidden" name="category" value="<%= @category_filter %>">
          <input type="hidden" name="expense_type" value="<%= @expense_type_filter %>">
          <div class="finance-search-group">
            <input type="text" name="search" value="<%= @search %>" class="form-control form-control-sm finance-filter-input"
                   placeholder="Buscar...">
            <button type="submit" class="finance-search-btn">
              <i class="fas fa-search"></i>
            </button>
          </div>
        <% end %>

        <div class="finance-filter-select">
          <select class="form-select form-select-sm finance-filter-input"
                  onchange="Turbo.visit(this.value, { frame: 'finance_expenses_frame' })">
            <option value="<%= finance_expenses_path(period: @period, currency: @currency_filter, search: @search, expense_type: @expense_type_filter) %>"
                    <%= 'selected' if @category_filter.blank? %>>
              Categoria
            </option>
            <% @categories.each do |cat| %>
              <option value="<%= finance_expenses_path(period: @period, currency: @currency_filter, category: cat.id, search: @search, expense_type: @expense_type_filter) %>"
                      <%= 'selected' if @category_filter == cat.id.to_s %>>
                <%= cat.name %>
              </option>
            <% end %>
          </select>
        </div>
      </div>

      <%# Row 4: Custom date range %>
      <div class="finance-filter-dates">
        <%= form_with url: finance_expenses_path, method: :get, data: { turbo_frame: "finance_expenses_frame" } do %>
          <input type="hidden" name="period" value="custom">
          <input type="hidden" name="currency" value="<%= @currency_filter %>">
          <input type="hidden" name="category" value="<%= @category_filter %>">
          <input type="hidden" name="search" value="<%= @search %>">
          <input type="hidden" name="expense_type" value="<%= @expense_type_filter %>">
          <div class="d-flex gap-2 align-items-center">
            <input type="date" name="start_date" value="<%= @start_date %>" class="form-control form-control-sm finance-filter-input finance-date-input">
            <span class="finance-filter-separator">a</span>
            <input type="date" name="end_date" value="<%= @end_date %>" class="form-control form-control-sm finance-filter-input finance-date-input">
            <button type="submit" class="btn btn-sm finance-filter-apply">
              <i class="fas fa-arrow-right"></i>
            </button>
          </div>
        <% end %>
      </div>
    </div>

    <div class="finance-expenses-total">
      <div class="total-label">Total &middot; <%= @start_date.strftime("%d/%m/%Y") %> a <%= @end_date.strftime("%d/%m/%Y") %></div>
      <div class="total-amount">$<%= money(@total_ars) %> <small style="font-size: 14px; font-weight: 500; opacity: 0.5;">ARS</small></div>
      <% if @settlements_net_ars && !@settlements_net_ars.zero? %>
        <div class="total-breakdown">
          Pagaste $<%= money(@paid_ars) %>
          &middot; saldos con <%= current_user.shared_group&.other_member(current_user)&.display_name %>
          <span class="<%= @settlements_net_ars.negative? ? 'is-negative' : 'is-positive' %>"><%= @settlements_net_ars.negative? ? "-" : "+" %>$<%= money(@settlements_net_ars.abs) %></span>
        </div>
      <% end %>
    </div>

    <div class="finance-expenses-scroll">
      <% if @rows.empty? %>
        <div class="text-center py-5 expense-empty">
          <i class="fas fa-inbox d-block mb-2"></i>
          No hay gastos en este periodo
        </div>
      <% end %>

      <div class="finance-expense-list">
        <% @rows.each do |row| %>
          <% if row.is_a?(Finance::Settlement) %>
            <% sent = row.sent_by?(current_user) %>
            <div class="finance-expense-row finance-settlement-row">
              <div class="expense-row-icon"><i class="fas fa-money-bill-transfer"></i></div>
              <div class="expense-row-info">
                <div class="expense-row-desc">
                  <% if sent %>Le pagaste a <%= row.to_user.display_name %><% else %><%= row.from_user.display_name %> te pago<% end %>
                </div>
                <div class="expense-row-meta"><%= row.description.presence || "Saldo de gastos compartidos" %></div>
              </div>
              <div class="expense-row-right">
                <div class="expense-row-date"><%= row.settled_on.strftime("%d/%m") %></div>
                <div class="expense-row-amount">
                  <span class="expense-amount <%= 'expense-amount--credit' unless sent %>"><%= sent ? "" : "-" %>$<%= money(row.amount_ars) %></span>
                </div>
              </div>
              <div class="expense-row-actions"></div>
            </div>
          <% else %>
            <% expense = row %>
            <div class="finance-expense-row">
              <div class="expense-row-icon <%= 'expense-row-icon--shared' if expense.shared? %>">
                <i class="fas <%= expense.category.icon %>"></i>
              </div>
              <div class="expense-row-info">
                <div class="expense-row-desc"><%= expense.description %></div>
                <div class="expense-row-meta">
                  <%= expense.category.name %> · <%= expense.expense_type == "fijo" ? "Fijo" : "Variable" %>
                  <% if expense.shared? %>
                    <% partner = expense.group.other_member(current_user) %>
                    <% total = expense.amount_ars.to_f %>
                    <% my_percent = total.positive? ? (expense.amount_ars_for(current_user).to_f / total * 100).round : 50 %>
                    <span class="expense-shared-note"><span class="note-label">compartido con</span> <span class="split-name"><%= partner&.display_name %></span> <span class="note-percent">(<%= my_percent %>%)</span></span>
                  <% end %>
                </div>
              </div>
              <div class="expense-row-right">
                <div class="expense-row-date"><%= expense.expense_date.strftime("%d/%m") %></div>
                <div class="expense-row-amount">
                  <% if expense.currency == "USD" %>
                    <span class="expense-amount expense-amount-usd">US$<%= money(expense.amount) %></span>
                    <% if expense.amount_ars.present? %>
                      <span class="expense-amount-ars-sub">~$<%= money(expense.amount_ars) %></span>
                    <% end %>
                  <% else %>
                    <span class="expense-amount">$<%= money(expense.amount) %></span>
                  <% end %>
                </div>
              </div>
              <div class="expense-row-actions">
                <%= form_with url: finance_expense_path(expense, period: @period, currency: @currency_filter,
                              category: @category_filter, search: @search, filter_expense_type: @expense_type_filter),
                              method: :patch do %>
                  <input type="hidden" name="expense[expense_type]" value="<%= expense.expense_type == 'fijo' ? 'variable' : 'fijo' %>">
                  <button type="submit" class="expense-action-btn expense-toggle-type"
                          title="<%= expense.expense_type == 'fijo' ? 'Cambiar a Variable' : 'Cambiar a Fijo' %>">
                    <i class="fas <%= expense.expense_type == 'fijo' ? 'fa-thumbtack' : 'fa-arrows-rotate' %>"></i>
                  </button>
                <% end %>
                <% if current_user.shared_group&.full? && expense.user_id == current_user.id %>
                  <%= form_with url: finance_expense_path(expense, period: @period, currency: @currency_filter,
                                category: @category_filter, search: @search, filter_expense_type: @expense_type_filter),
                                method: :patch do %>
                    <input type="hidden" name="expense[shared]" value="<%= expense.shared? ? '0' : '1' %>">
                    <button type="submit" class="expense-action-btn" title="<%= expense.shared? ? 'Hacer personal' : 'Compartir' %>">
                      <i class="fas <%= expense.shared? ? 'fa-user' : 'fa-user-friends' %>"></i>
                    </button>
                  <% end %>
                <% end %>
                <%= form_with url: finance_expense_path(expense, period: @period, currency: @currency_filter,
                              category: @category_filter, search: @search, filter_expense_type: @expense_type_filter),
                              method: :delete do %>
                  <button type="submit" class="expense-action-btn expense-delete-btn"
                          title="Eliminar">
                    <i class="fas fa-trash-alt"></i>
                  </button>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </turbo-frame>
</div>
